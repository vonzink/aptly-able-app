# Copy to .env on the server. Never share this file after adding secrets.
SITE_ADDRESS=api.plaud.aptlyable.info
PUBLIC_ORIGIN=https://plaud.aptlyable.info
API_ORIGIN=https://api.plaud.aptlyable.info
RELEASE_TAG=2026-09-14
# Use 64 hexadecimal characters (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=
PLAUD_CLIENT_ID=
PLAUD_CLIENT_SECRET=
PLAUD_REGION=us
ANDROID_DOWNLOAD_URL=https://plaud.aptlyable.info/downloads/aptly-able-android.apk
# Add the real public TestFlight link once Apple approves the build.
IOS_TESTFLIGHT_URL=
DOWNLOADS_DIRECTORY=./downloads
