# Expo-generated native projects; keep our native Plaud bridge source.
**/ios/
**/android/
!apps/mobile/modules/plaud-sdk/ios/
!apps/mobile/modules/plaud-sdk/android/
# Native SDKs are restored from the documented provenance, not committed with app source.
apps/mobile/modules/plaud-sdk/ios/Frameworks/
apps/mobile/modules/plaud-sdk/android/libs/*.aar

