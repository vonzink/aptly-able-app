{
  "name": "@aptly/mobile",
  "private": true,
  "version": "0.1.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8088",
    "ios": "node ../../scripts/check-plaud-sdk.mjs ios && expo run:ios --device",
    "android": "node ../../scripts/check-plaud-sdk.mjs android && expo prebuild --platform android --no-install --no-clean && expo run:android --device",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform all"
  },
  "dependencies": {
    "@aptly/api-client": "workspace:*",
    "@aptly/contracts": "workspace:*",
    "@aptly/product-content": "workspace:*",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/metro-runtime": "57.0.15",
    "@expo/ui": "57.0.18",
    "@expo/vector-icons": "15.0.3",
    "expo": "57.0.21",
    "expo-application": "57.0.2",
    "expo-asset": "57.0.16",
    "expo-audio": "57.0.4",
    "expo-clipboard": "57.0.1",
    "expo-constants": "57.0.17",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.18",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "57.0.6",
    "expo-font": "57.0.3",
    "expo-linking": "57.0.9",
    "expo-modules-core": "57.0.17",
    "expo-router": "57.0.20",
    "expo-secure-store": "57.0.3",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-widgets": "57.0.19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.4"
  }
}
