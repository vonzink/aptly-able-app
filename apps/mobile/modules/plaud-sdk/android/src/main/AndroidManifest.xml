<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    The Bluetooth / location permissions the SDK needs are declared by plaud-sdk.aar's own
    manifest and reach the app through manifest merging, so they are not repeated here.
    They still have to be *granted* at runtime on Android 12+ — PlaudSdkModule.startScan()
    requests them via `requestPermissions()` before it touches the SDK.
  -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
  <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
</manifest>
