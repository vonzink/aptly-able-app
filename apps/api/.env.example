# Local development only. The API defaults to loopback; never expose the dev session publicly.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
# Matches this workspace's optional local Docker database.
DATABASE_URL=postgres://aptly:aptly_local_only@127.0.0.1:55432/aptly_mobile
# Optional. Both are required to enable GET /v1/session; generate your own values.
# DEV_SESSION_TOKEN=<32-or-more-random-url-safe-characters>
# DEV_USER_ID=<stable-internal-uuid>
# DEV_USER_DISPLAY_NAME="Local user"
# Separate administrator credential. Never reuse the ordinary user's token or UUID.
# DEV_ADMIN_SESSION_TOKEN=<a-different-32-or-more-random-url-safe-credential>
# DEV_ADMIN_USER_ID=<a-different-stable-internal-uuid>
# DEV_ADMIN_DISPLAY_NAME="Local administrator"
# Required only for invitation issuance. No landing page/domain is provisioned by this API.
# HTTPS, maximum 512 characters, no username/password, query string or fragment.
# Loopback HTTP is accepted only in development/test. Replace this example with your destination.
# ENROLLMENT_BASE_URL=https://enroll.example.test/setup
# Installed development app: ENROLLMENT_BASE_URL=aptlyable://enroll
# Local enrollment UI: http://localhost:8088/enroll
# Explicit browser origin allowlist. Native requests still require bearer authentication.
# BROWSER_ORIGINS=http://localhost:8088,http://localhost:8089,http://127.0.0.1:8088,http://127.0.0.1:8089

# Native device SDK: configure CLIENT_ID and CLIENT_SECRET together.
# Automatic transcription additionally requires API_KEY from the same application.
# Keep these backend-only; API_KEY is separate from CLIENT_SECRET.
# PLAUD_CLIENT_ID=
# PLAUD_CLIENT_SECRET=
# PLAUD_API_KEY=
# PLAUD_REGION=us
# Optional absolute directory for verified uploads; default is this workspace's .local/recordings.
# RECORDINGS_DIRECTORY=/absolute/path/to/recordings
