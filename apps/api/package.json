{
  "name": "@aptly/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/bootstrap/server.ts",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-api-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/bootstrap/server.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/bootstrap/migrate.ts",
    "db:seed-dev": "tsx --env-file-if-exists=.env src/bootstrap/seed-development.ts"
  },
  "dependencies": {
    "@aptly/contracts": "workspace:*",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.13"
  }
}
